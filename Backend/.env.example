# Neo4j AuraDB Configuration
# Connection URI for Neo4j instance (e.g., neo4j+s://<instance-id>.databases.neo4j.io)
NEO4J_URI=neo4j+s://your-neo4j-instance-id.databases.neo4j.io

# Database username (typically 'neo4j' for AuraDB)
NEO4J_USERNAME=your-neo4j-username-here

# Database password
NEO4J_PASSWORD=your-neo4j-password-here

# Optional: Specific database name (defaults to driver default/neo4j if unset)
NEO4J_DATABASE=neo4j

# Qdrant Cloud Configuration
# Qdrant cluster endpoint URL
QDRANT_URL=https://your-qdrant-cluster-url.cloud.qdrant.io

# Qdrant Cloud API Key
QDRANT_API_KEY=your-qdrant-api-key-here

# Application Configuration
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application environment (e.g., development, production, test)
ENVIRONMENT=development

# GitHub OAuth Integration (Optional - required for private repo OAuth)
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here
OAUTH_STATE_SECRET=your-random-hmac-signing-secret-here
